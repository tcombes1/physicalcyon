!!!
%html
  %head
    %title= content_for(:title) || "Physicalcyon"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Physicalcyon" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: "icon", href: "/icon.png", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/icon.png" }
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    / Apply saved theme before first paint to prevent flash
    :javascript
      (function(){
        var t = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (t === 'dark') document.documentElement.classList.add('dark');
      })();

  %body{ class: "h-screen overflow-hidden bg-taupe-50 text-taupe-900 dark:bg-taupe-950 dark:text-taupe-100" }
    .flex.h-full

      / ── Left sidebar ─────────────────────────────────────────────
      %nav{ class: "w-56 flex-shrink-0 flex flex-col border-r bg-stone-300 border-taupe-200 dark:bg-taupe-900 dark:border-taupe-800" }

        / Header
        .flex.items-center.justify-between.gap-2.px-4.py-3{ class: "border-b border-taupe-200 dark:border-taupe-800" }
          %span{ class: "font-semibold text-sm tracking-wide truncate text-taupe-800 dark:text-taupe-100" } Physicalcyon
          = link_to "+ Upload", new_cad_model_path,
              class: "flex-shrink-0 text-xs px-2 py-1 rounded font-medium transition-colors bg-taupe-800 text-taupe-50 hover:bg-taupe-700 dark:bg-taupe-200 dark:text-taupe-900 dark:hover:bg-taupe-300"

        / Model list
        .flex-1.overflow-y-auto.py-2
          %p{ class: "px-4 py-1 text-xs font-semibold uppercase tracking-wider text-taupe-400 dark:text-taupe-600" } Models

          - if @sidebar_models&.any?
            - @sidebar_models.each do |m|
              - active = defined?(@cad_model) && @cad_model&.id == m.id
              = link_to cad_model_path(m),
                  class: "flex items-center gap-2.5 px-3 py-2 mx-1 rounded text-sm transition-colors #{active ? 'bg-taupe-200 text-taupe-900 dark:bg-taupe-800 dark:text-taupe-100' : 'text-taupe-500 dark:text-taupe-400 hover:bg-taupe-200 dark:hover:bg-taupe-800 hover:text-taupe-900 dark:hover:text-taupe-100'}" do
                %span{ class: "w-2 h-2 rounded-full flex-shrink-0 #{status_dot_class(m.status)}" }
                %span.truncate= m.name.presence || "Untitled"
          - else
            %p{ class: "px-4 py-2 text-xs text-taupe-400 dark:text-taupe-600" } No models yet.

        / Footer: theme toggle
        .px-4.py-3{ class: "border-t border-taupe-200 dark:border-taupe-800",
                    data: { controller: "theme-toggle" } }
          %button{ data: { action: "click->theme-toggle#toggle" },
                   class: "flex items-center gap-2 text-xs font-medium transition-colors text-taupe-500 dark:text-taupe-400 hover:text-taupe-800 dark:hover:text-taupe-200" }
            %span{ data: { "theme-toggle-target": "icon" } } ☾
            %span Appearance

      / ── Main content area ────────────────────────────────────────
      %main{ class: "flex-1 relative overflow-hidden bg-taupe-50 dark:bg-taupe-950" }
        = yield
