!!!
%html
  %head
    %title= content_for(:title) || "Physicalcyon"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Physicalcyon" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: "icon", href: "/icon.png", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/icon.png" }
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    / Apply saved theme before first paint to prevent flash
    :javascript
      (function(){
        var t = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (t === 'dark') document.documentElement.classList.add('dark');
      })();

  %body{ class: "h-screen overflow-hidden bg-taupe-50 text-taupe-900 dark:bg-taupe-950 dark:text-taupe-100" }
    .flex.h-full

      / ── Left sidebar ─────────────────────────────────────────────
      %nav{ class: "w-56 flex-shrink-0 flex flex-col border-r bg-mist-300 border-taupe-200 dark:bg-mist-700 dark:border-taupe-800" }

        / Header
        .flex.items-center.justify-between.gap-2.px-4.py-3{ class: "border-b border-taupe-200 dark:border-taupe-800" }
          %span{ class: "font-semibold text-sm tracking-wide truncate text-taupe-800 dark:text-taupe-100" } Physicalcyon
          = link_to "+ Upload", new_cad_model_path,
              class: "flex-shrink-0 text-xs px-2 py-1 rounded font-medium transition-colors bg-taupe-800 text-taupe-50 hover:bg-taupe-700 dark:bg-taupe-200 dark:text-taupe-900 dark:hover:bg-taupe-300"

        / Part hierarchy
        .flex-1.overflow-y-auto.py-2
          - if defined?(@cad_model) && @cad_model
            / Back link
            = link_to cad_models_path,
                class: "flex items-center gap-1 px-3 py-1 mb-1 text-xs transition-colors text-taupe-400 dark:text-taupe-600 hover:text-taupe-700 dark:hover:text-taupe-300" do
              %span ←
              %span All models

            / Model name header
            %p{ class: "px-3 pb-1 pt-0.5 text-xs font-semibold uppercase tracking-wider truncate text-taupe-700 dark:text-taupe-300" }
              = @cad_model.name.presence || "Untitled"

            / Part tree — populated by JS once the glTF loads
            %div{ data: { controller: "part-tree" } }
              %p{ data: { "part-tree-target": "placeholder" },
                  class: "px-3 py-1 text-xs text-taupe-400 dark:text-taupe-600 italic" }
                - if @cad_model.done?
                  = "Loading parts…"
                - else
                  = @cad_model.status.capitalize + "…"
          - else
            = link_to cad_models_path,
                class: "flex items-center gap-1 px-3 py-1 text-xs transition-colors text-taupe-400 dark:text-taupe-600 hover:text-taupe-700 dark:hover:text-taupe-300" do
              %span ←
              %span All models

        / Footer: theme toggle
        .px-4.py-3{ class: "border-t border-taupe-200 dark:border-taupe-800",
                    data: { controller: "theme-toggle" } }
          %button{ data: { action: "click->theme-toggle#toggle" },
                   class: "flex items-center gap-2 text-xs font-medium transition-colors text-taupe-500 dark:text-taupe-400 hover:text-taupe-800 dark:hover:text-taupe-200" }
            %span{ data: { "theme-toggle-target": "icon" } } ☾
            %span Appearance

      / ── Main content area ────────────────────────────────────────
      %main{ class: "flex-1 relative overflow-hidden bg-mist-400 dark:bg-mist-800" }
        = yield
