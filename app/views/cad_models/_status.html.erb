<%= turbo_frame_tag "cad_model_status_#{cad_model.id}" do %>
  <% if cad_model.pending? %>
    <div class="flex items-center gap-2 text-gray-500 mt-4">
      <svg class="animate-spin h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span>Queued…</span>
    </div>

  <% elsif cad_model.processing? %>
    <div class="flex items-center gap-2 text-blue-600 mt-4">
      <svg class="animate-spin h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span>Converting…</span>
    </div>

  <% elsif cad_model.failed? %>
    <div class="mt-4 rounded-md bg-red-50 p-4 border border-red-200">
      <p class="font-semibold text-red-700 mb-1">Conversion failed</p>
      <pre class="text-sm text-red-600 whitespace-pre-wrap"><%= cad_model.conversion_error %></pre>
    </div>

  <% elsif cad_model.done? %>
    <div class="mt-4">
      <% if cad_model.thumbnail.attached? %>
        <div class="mb-4">
          <%= image_tag rails_blob_path(cad_model.thumbnail), class: "rounded-md max-h-48 border", alt: "#{cad_model.name} thumbnail" %>
        </div>
      <% end %>

      <div
        data-controller="model-viewer"
        data-model-viewer-url-value="<%= rails_blob_path(cad_model.gltf_file) %>"
        class="relative w-full rounded-lg overflow-hidden border border-gray-200"
        style="height: 480px;"
      >
        <div class="absolute top-2 right-2 z-10 flex gap-1">
          <% [["XY", "xy"], ["XZ", "xz"], ["YZ", "yz"], ["ISO", "iso"]].each do |label, view| %>
            <button
              data-action="click->model-viewer#setView"
              data-model-viewer-view-param="<%= view %>"
              class="px-2 py-1 text-xs font-mono font-semibold rounded bg-white/80 hover:bg-white border border-gray-300 text-gray-700 shadow-sm backdrop-blur-sm transition-colors"
            ><%= label %></button>
          <% end %>
          <% [["↻X", "rotateX"], ["↻Y", "rotateY"], ["↻Z", "rotateZ"]].each do |label, action| %>
            <button
              data-action="click->model-viewer#<%= action %>"
              class="px-2 py-1 text-xs font-mono font-semibold rounded bg-white/80 hover:bg-white border border-gray-300 text-gray-700 shadow-sm backdrop-blur-sm transition-colors"
            ><%= label %></button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
