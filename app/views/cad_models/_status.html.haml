= turbo_frame_tag "cad_model_status_#{cad_model.id}", class: "absolute inset-0 block" do

  - if cad_model.pending?
    .absolute.inset-0.flex.items-center.justify-center
      .flex.items-center.gap-3{ class: "text-taupe-400 dark:text-taupe-500" }
        %svg.animate-spin.h-6.w-6{ xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24" }
          %circle.opacity-25{ cx: "12", cy: "12", r: "10", stroke: "currentColor", "stroke-width": "4" }
          %path.opacity-75{ fill: "currentColor", d: "M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" }
        %span.text-lg Queued…

  - elsif cad_model.processing?
    .absolute.inset-0.flex.items-center.justify-center
      .flex.items-center.gap-3{ class: "text-taupe-500 dark:text-taupe-400" }
        %svg.animate-spin.h-6.w-6{ xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24" }
          %circle.opacity-25{ cx: "12", cy: "12", r: "10", stroke: "currentColor", "stroke-width": "4" }
          %path.opacity-75{ fill: "currentColor", d: "M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" }
        %span.text-lg Converting…

  - elsif cad_model.failed?
    .absolute.inset-0.flex.items-center.justify-center.p-8
      .rounded-lg.border.p-6.max-w-lg.w-full{ class: "bg-red-50 border-red-200 dark:bg-red-950 dark:border-red-800" }
        %p{ class: "font-semibold mb-2 text-red-700 dark:text-red-400" } Conversion failed
        %pre{ class: "text-sm whitespace-pre-wrap text-red-600 dark:text-red-300" }= cad_model.conversion_error

  - elsif cad_model.done?
    %div{ data: { controller: "model-viewer", model_viewer_url_value: rails_blob_path(cad_model.gltf_file) },
          class: "absolute inset-0" }

      / ── Right controls panel ──────────────────────────────────
      %div{ class: "absolute right-3 top-1/2 -translate-y-1/2 z-10 flex flex-col gap-1" }

        - [["XY", "xy"], ["XZ", "xz"], ["YZ", "yz"], ["ISO", "iso"]].each do |label, view|
          %button{ data: { action: "click->model-viewer#setView", model_viewer_view_param: view },
                   class: "w-10 py-1.5 text-xs font-mono font-semibold rounded text-center transition-colors backdrop-blur-sm border bg-taupe-100/70 hover:bg-taupe-200/80 border-taupe-300/60 text-taupe-700 dark:bg-taupe-900/60 dark:hover:bg-taupe-800/70 dark:border-taupe-700/50 dark:text-taupe-300" }
            = label

        %div{ class: "my-0.5 border-t border-taupe-300/50 dark:border-taupe-700/50" }

        - [["↻X", "rotateX"], ["↻Y", "rotateY"], ["↻Z", "rotateZ"]].each do |label, action|
          %button{ data: { action: "click->model-viewer##{action}" },
                   class: "w-10 py-1.5 text-xs font-mono font-semibold rounded text-center transition-colors backdrop-blur-sm border bg-taupe-100/70 hover:bg-taupe-200/80 border-taupe-300/60 text-taupe-700 dark:bg-taupe-900/60 dark:hover:bg-taupe-800/70 dark:border-taupe-700/50 dark:text-taupe-300" }
            = label
