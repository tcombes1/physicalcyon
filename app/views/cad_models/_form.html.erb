<%= form_with(model: cad_model, class: "contents") do |form| %>
  <% if cad_model.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(cad_model.errors.count, "error") %> prohibited this cad_model from being saved:</h2>

      <ul class="list-disc ml-6">
        <% cad_model.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": cad_model.errors[:name].none?, "border-red-400 focus:outline-red-600": cad_model.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": cad_model.errors[:description].none?, "border-red-400 focus:outline-red-600": cad_model.errors[:description].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :file_format %>
    <%= form.text_field :file_format, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": cad_model.errors[:file_format].none?, "border-red-400 focus:outline-red-600": cad_model.errors[:file_format].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :file %>
    <%= form.file_field :file, class: "block mt-2 w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
